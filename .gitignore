# Terraform / OpenTofu
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# local variable overrides — may contain addresses or secrets
*.auto.tfvars
terraform.tfvars
!*.tfvars.example

# local resource overrides and CLI config — the CLI config can hold registry tokens
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# kubeconfigs and API tokens live in ~/.kube and ~/.config, never in a checkout
kubeconfig
*.kubeconfig
k3s.yaml
*.token

# macOS
.DS_Store

# helm dependency build downloads the pinned charts here from Chart.lock
platform/*/charts/

# tofu test copies a root's lock file into the module; the roots' lock files are the tracked ones
terraform/modules/*/.terraform.lock.hcl
