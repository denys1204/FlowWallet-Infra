#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
timezone: ${timezone}

users:
  - name: ${username}
    groups: [ sudo ]
    shell: /bin/bash
    sudo: 'ALL=(ALL) NOPASSWD:ALL'
    ssh_authorized_keys:
      - ${ssh_key}

# Password login stays off; the injected key is the only way in.
ssh_pwauth: false
disable_root: true

package_update: true
packages:
  - qemu-guest-agent
  - curl

runcmd:
  - systemctl enable --now qemu-guest-agent

# k3s itself is installed in stage 1, on purpose: this template has to stay
# useful for any lab VM, not only Kubernetes nodes.
