#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
timezone: ${timezone}

users:
  - name: ${username}
    groups: [ sudo ]
    shell: /bin/bash
    sudo: 'ALL=(ALL) NOPASSWD:ALL'
    ssh_authorized_keys:
      - ${ssh_key}

# Password login stays off; the injected key is the only way in.
ssh_pwauth: false
disable_root: true

package_update: true
packages:
  - qemu-guest-agent
  - curl
  # nft only: Debian's nftables.service stays disabled, its config would flush k3s's rules.
  - nftables

write_files:
  # Holds the agent token, hence 0600.
  - path: /etc/rancher/k3s/config.yaml
    permissions: '0600'
    content: |
      ${indent(6, k3s_config)}
  # Kubelet settings without a command-line flag. k3s points the kubelet at this
  # directory and writes its own 00-k3s-defaults.conf there; 50- is read after it.
  - path: /var/lib/rancher/k3s/agent/etc/kubelet.conf.d/50-px-lab.conf
    permissions: '0644'
    content: |
      ${indent(6, kubelet_config)}
  # Graceful node shutdown needs logind to allow a delay longer than the kubelet's
  # 60 s grace period. Debian's unattended-upgrades ships a drop-in that caps it at
  # 30 s, and drop-ins apply in file-name order across /etc and /usr/lib, so this
  # one is named to sort last. Without it the kubelet gives up on graceful shutdown.
  - path: /etc/systemd/logind.conf.d/zz-px-lab-shutdown.conf
    permissions: '0644'
    content: |
      [Login]
      InhibitDelayMaxSec=70
  # Node firewall: the other clusters cannot reach this node (see fw.nft.tftpl).
  - path: /etc/px-lab/fw.nft
    permissions: '0644'
    content: |
      ${indent(6, firewall)}
  - path: /etc/systemd/system/px-lab-fw.service
    permissions: '0644'
    content: |
      [Unit]
      Description=px-lab node firewall (keeps the lab clusters apart)
      Wants=network-pre.target
      Before=network-pre.target k3s.service k3s-agent.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/sbin/nft -f /etc/px-lab/fw.nft
      ExecReload=/usr/sbin/nft -f /etc/px-lab/fw.nft

      [Install]
      WantedBy=multi-user.target
%{ if role == "server" ~}
  - path: /var/lib/rancher/k3s/server/psa.yaml
    permissions: '0600'
    content: |
      ${indent(6, psa_config)}
%{ endif ~}
  - path: /usr/local/sbin/px-k3s-install
    permissions: '0700'
    content: |
      ${indent(6, install_script)}

# A failed checksum or install leaves `cloud-init status` at error, which is
# how a bring-up script notices.
runcmd:
  - systemctl enable --now qemu-guest-agent
  # logind rereads its config on SIGHUP; it must see the new delay before the kubelet starts
  - systemctl kill --signal=HUP systemd-logind
  # the firewall is up before k3s starts
  - systemctl daemon-reload
  - systemctl enable --now px-lab-fw.service
  - /usr/local/sbin/px-k3s-install
